{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://knowledge-trainer.local/schema/kt-qbf/1.0/enhancement.json",
  "title": "KT-QBF 1.0 enhancement index record (enhancements/index.ndjson)",
  "type": "object",
  "additionalProperties": false,
  "required": ["questionId", "locale", "kind", "path", "reviewStatus"],
  "properties": {
    "questionId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$" },
    "locale": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Z][a-z]{3})?(-[A-Z]{2}|-[0-9]{3})?$" },
    "kind": { "enum": ["reconstruction", "distractor", "graph"] },
    "path": { "type": "string", "pattern": "^enhancements/[^\\\\:*?\"<>|\\x00-\\x1f]+$" },
    "reviewStatus": { "enum": ["unreviewed", "reviewed"] },
    "answerHash": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
    "ruleVersion": { "type": "string", "maxLength": 32 },
    "source": { "type": "string", "maxLength": 200 }
  }
}
