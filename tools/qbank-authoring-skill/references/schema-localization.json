{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://knowledge-trainer.local/schema/kt-qbf/1.0/localization.json",
  "title": "KT-QBF 1.0 localization record (locales/<locale>/questions.ndjson)",
  "type": "object",
  "additionalProperties": false,
  "required": ["questionId", "locale", "promptMarkdown"],
  "properties": {
    "questionId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$" },
    "locale": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Z][a-z]{3})?(-[A-Z]{2}|-[0-9]{3})?$" },
    "contentRevision": { "type": "integer", "minimum": 1, "maximum": 1000000 },
    "promptMarkdown": { "type": "string", "minLength": 1, "maxLength": 20000 },
    "options": {
      "type": "array",
      "minItems": 2,
      "maxItems": 26,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["optionId", "contentMarkdown"],
        "properties": {
          "optionId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$" },
          "contentMarkdown": { "type": "string", "minLength": 1, "maxLength": 20000 }
        }
      }
    },
    "answerText": { "type": "string", "minLength": 1, "maxLength": 20000 },
    "explanationMarkdown": { "type": "string", "maxLength": 20000 },
    "assets": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$" }
    }
  }
}
