{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://knowledge-trainer.local/schema/kt-qbf/1.0/media.json",
  "title": "KT-QBF 1.0 media index record (media/index.ndjson)",
  "type": "object",
  "additionalProperties": false,
  "required": ["assetId", "path", "mimeType", "bytes", "sha256"],
  "properties": {
    "assetId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$" },
    "path": { "type": "string", "pattern": "^media/[^\\\\:*?\"<>|\\x00-\\x1f]+$" },
    "mimeType": { "enum": ["image/png", "image/jpeg", "image/webp", "image/gif", "image/svg+xml"] },
    "bytes": { "type": "integer", "minimum": 1, "maximum": 20971520 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "width": { "type": "integer", "minimum": 1, "maximum": 20000 },
    "height": { "type": "integer", "minimum": 1, "maximum": 20000 },
    "alt": { "type": "string", "maxLength": 500 }
  }
}
