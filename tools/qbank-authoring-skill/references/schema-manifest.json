{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://knowledge-trainer.local/schema/kt-qbf/1.0/manifest.json",
  "title": "KT-QBF 1.0 manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schemaVersion", "bankId", "contentRevision", "title", "sourceLocale", "supportedLocales", "author", "files"],
  "properties": {
    "format": { "const": "knowledge-trainer-question-bank" },
    "schemaVersion": { "type": "string", "pattern": "^1\\.0\\.[0-9]+$" },
    "bankId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "contentRevision": { "type": "integer", "minimum": 1, "maximum": 1000000 },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "description": { "type": "string", "maxLength": 4000 },
    "sourceLocale": { "$ref": "#/definitions/locale" },
    "supportedLocales": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/locale" }
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["displayName"],
      "properties": {
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "contacts": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "label"],
            "properties": {
              "type": { "enum": ["email", "url", "github", "other"] },
              "label": { "type": "string", "minLength": 1, "maxLength": 80 },
              "address": { "type": "string", "minLength": 1, "maxLength": 320 },
              "url": { "type": "string", "minLength": 1, "maxLength": 500 }
            },
            "anyOf": [
              { "required": ["address"] },
              { "required": ["url"] }
            ]
          }
        }
      }
    },
    "license": { "type": "string", "maxLength": 100 },
    "tags": {
      "type": "array",
      "maxItems": 40,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 32 }
    },
    "sources": {
      "type": "array",
      "maxItems": 200,
      "items": { "$ref": "#/definitions/sourceRef" }
    },
    "contentDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "createdAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "files": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5000,
      "items": { "$ref": "#/definitions/fileRef" }
    }
  },
  "definitions": {
    "locale": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Z][a-z]{3})?(-[A-Z]{2}|-[0-9]{3})?$" },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "title"],
      "properties": {
        "sourceId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 300 },
        "kind": { "enum": ["book", "paper", "web", "course", "original", "other"] },
        "author": { "type": "string", "maxLength": 200 },
        "edition": { "type": "string", "maxLength": 120 },
        "url": { "type": "string", "minLength": 1, "maxLength": 500 },
        "license": { "type": "string", "maxLength": 100 },
        "note": { "type": "string", "maxLength": 1000 }
      }
    },
    "fileRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "^(questions|locales|media|enhancements)/[^\\\\:*?\"<>|\\x00-\\x1f]+$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
